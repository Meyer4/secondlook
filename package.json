{
  "name": "secondlook",
  "version": "1.1.0",
  "private": true,
  "description": "A privacy-first, on-device toolkit for everyday digital safety.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.js",
    "bundle": "python3 scripts/bundle.py",
    "test:browser": "playwright test",
    "sync:companions": "node scripts/sync-companions.mjs",
    "test:extension": "playwright test -c playwright.extension.config.js",
    "package:companions": "node scripts/sync-companions.mjs && python3 scripts/package-companions.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0"
  }
}
